# Immortality Publisher — Goclaw Skill
# Copy to .env and fill in values. Never commit .env.

# Firebase Auth account dedicated to the Agent
# Create in Firebase Console → Authentication → Users → Add user
IMMORTALITY_AGENT_EMAIL=agent@battudao.com
IMMORTALITY_AGENT_PASSWORD=

# Firebase project public config
# Same values as VITE_FIREBASE_* in apps/immortality-vn/.env
IMMORTALITY_FIREBASE_API_KEY=
IMMORTALITY_FIREBASE_PROJECT_ID=immortalityvn
IMMORTALITY_FIREBASE_AUTH_DOMAIN=immortalityvn.firebaseapp.com

# Optional: override inbox location (default: ../../inbox/khaitri relative to script)
# IMMORTALITY_INBOX_DIR=/absolute/path/to/inbox/khaitri
