OPENHANDS_ADAPTER_PORT=8091
OPENHANDS_ADAPTER_AUTH_TOKEN=change-me
OPENHANDS_ADAPTER_PUBLIC_BASE_URL=https://openhands.blackbirdzzzz.art

OPENHANDS_LLM_MODEL=openai/gpt-4.1-mini
OPENHANDS_LLM_API_KEY=change-me
OPENHANDS_LLM_BASE_URL=
OPENHANDS_LLM_REASONING_EFFORT=high

OPENHANDS_WORKSPACE_SERVER_IMAGE=ghcr.io/openhands/agent-server:latest-python
OPENHANDS_WORKSPACE_PLATFORM=linux/arm64
OPENHANDS_WORKSPACE_HOST=http://host.docker.internal
OPENHANDS_WORKSPACE_NETWORK=

OPENHANDS_DEFAULT_MAX_RUNTIME_SEC=1800
OPENHANDS_MAX_RUNTIME_SEC=7200
OPENHANDS_DEFAULT_MAX_ITERATIONS=150
OPENHANDS_MAX_ITERATIONS=500
OPENHANDS_MAX_CONCURRENT_JOBS=2
OPENHANDS_MAX_UPLOAD_MB=64
OPENHANDS_ALLOWED_REPO_PREFIXES=https://github.com/nextlevelbuilder/,https://github.com/blackbird/
OPENHANDS_GITHUB_APP_ID=
OPENHANDS_GITHUB_APP_PRIVATE_KEY_PATH=
OPENHANDS_GITHUB_APP_PRIVATE_KEY_B64=
OPENHANDS_GITHUB_APP_API_BASE_URL=https://api.github.com
OPENHANDS_GITHUB_APP_ALLOWED_OWNERS=
