FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    ripgrep \
    util-linux \
    bsdextrautils \
  && rm -rf /var/lib/apt/lists/*

# Pre-install the libraries agents reach for on data/office tasks so they don't
# have to bootstrap them at runtime (the slow pip/venv/ensurepip dance Debian's
# PEP-668 guard forces). System-wide (root, --break-system-packages) so the
# sandbox user can import them. Covers: HTTP + scraping (requests/httpx/
# beautifulsoup4/lxml), data (pandas/numpy via pandas), spreadsheets (openpyxl),
# documents (python-docx, reportlab for PDF), and table formatting (tabulate).
RUN pip3 install --break-system-packages --no-cache-dir \
    requests \
    httpx \
    beautifulsoup4 \
    lxml \
    pandas \
    openpyxl \
    python-docx \
    reportlab \
    tabulate \
    pyyaml

# Node.js + connected external-agent CLIs. Installed globally as root so the
# sandbox user can invoke them. Claude Code is the first connected agent; add
# other CLIs (aider, codex, gemini-cli, …) here as they're supported. These
# only reach their APIs when the sandbox exec has network enabled (the
# delegate_external path) — regular code exec stays --network none.
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && npm install -g @anthropic-ai/claude-code \
  && npm cache clean --force \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["sleep", "infinity"]
