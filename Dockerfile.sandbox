FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    ripgrep \
    util-linux \
    bsdextrautils \
  && rm -rf /var/lib/apt/lists/*

# Pre-install the libraries agents reach for on data/office tasks so they don't
# have to bootstrap them at runtime (the slow pip/venv/ensurepip dance Debian's
# PEP-668 guard forces). System-wide (root, --break-system-packages) so the
# sandbox user can import them. Covers: HTTP + scraping (requests/httpx/
# beautifulsoup4/lxml), data (pandas/numpy via pandas), spreadsheets (openpyxl),
# documents (python-docx, reportlab for PDF), and table formatting (tabulate).
RUN pip3 install --break-system-packages --no-cache-dir \
    requests \
    httpx \
    beautifulsoup4 \
    lxml \
    pandas \
    openpyxl \
    python-docx \
    reportlab \
    tabulate \
    pyyaml \
    pyte

# Node.js + connected external-agent CLIs. Installed globally as root so the
# sandbox user can invoke them. Claude Code is the first connected agent; add
# other CLIs (aider, codex, gemini-cli, …) here as they're supported. These
# only reach their APIs when the sandbox exec has network enabled (the
# delegate_external path) — regular code exec stays --network none.
RUN set -eux; \
  ARCH="$(dpkg --print-architecture)"; \
  case "$ARCH" in amd64) NODEARCH=x64 ;; arm64) NODEARCH=arm64 ;; *) echo "unsupported arch $ARCH" >&2; exit 1 ;; esac; \
  curl -fsSL "https://nodejs.org/dist/v20.18.0/node-v20.18.0-linux-${NODEARCH}.tar.gz" -o /tmp/node.tar.gz; \
  tar -xzf /tmp/node.tar.gz -C /usr/local --strip-components=1; \
  rm /tmp/node.tar.gz; \
  node --version; npm --version; \
  npm install -g @anthropic-ai/claude-code; \
  npm cache clean --force

# Go toolchain — so a delegated agent (Claude Code) can `go build`/test its
# refactor in a loop inside the sandbox before the result is pushed. Fetched
# directly from go.dev (no flaky third-party apt repos). Added to PATH below.
RUN set -eux; \
  ARCH="$(dpkg --print-architecture)"; \
  case "$ARCH" in amd64) GOARCH=amd64 ;; arm64) GOARCH=arm64 ;; *) echo "unsupported arch $ARCH" >&2; exit 1 ;; esac; \
  curl -fsSL "https://go.dev/dl/go1.25.0.linux-${GOARCH}.tar.gz" -o /tmp/go.tar.gz; \
  tar -xzf /tmp/go.tar.gz -C /usr/local; \
  rm /tmp/go.tar.gz; \
  /usr/local/go/bin/go version
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOTOOLCHAIN=local

# GitHub CLI — lets the delegated agent clone/push and open PRs (with GH_TOKEN
# injected at exec time by delegate_external).
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["sleep", "infinity"]
