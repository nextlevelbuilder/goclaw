		)
		if err != nil {
			return nil, err
		}

		batch, scanErr := scanRelations(rows)
		rows.Close()
		if scanErr != nil {
			return nil, scanErr
		}
		result = append(result, batch...)
		if len(batch) < exportBatchSize {
			break
		}
		lastID := mustParseUUID(batch[len(batch)-1].ID)
		cursor = lastID
