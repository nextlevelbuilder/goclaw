import { useHttp } from "@/hooks/use-ws";
import { queryKeys } from "@/lib/query-keys";

export interface ChatGPTOAuthQuotaWindow {
  label: string;
  used_percent: number;
  remaining_percent: number;
  reset_after_seconds?: number | null;
