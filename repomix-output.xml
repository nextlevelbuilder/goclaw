	c := NewRedisCache[int](client, "test:clear")
	ctx := context.Background()

	c.Set(ctx, "a", 1, time.Minute)
	c.Set(ctx, "b", 2, time.Minute)
	c.Clear(ctx)

	if _, ok := c.Get(ctx, "a"); ok {
		t.Fatal("expected miss after clear")
	}
	if _, ok := c.Get(ctx, "b"); ok {
		t.Fatal("expected miss after clear")
	}
