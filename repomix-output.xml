	v, ok := c.Get(ctx, "k1")
	if !ok || v != 42 {
		t.Fatalf("expected 42, got %d ok=%v", v, ok)
	}

	time.Sleep(150 * time.Millisecond)
	_, ok = c.Get(ctx, "k1")
	if ok {
