	c := NewRedisCache[string](client, "test:del")
	ctx := context.Background()

	c.Set(ctx, "k1", "v1", time.Minute)
	c.Delete(ctx, "k1")

	_, ok := c.Get(ctx, "k1")
	if ok {
		t.Fatal("expected miss after delete")
	}
