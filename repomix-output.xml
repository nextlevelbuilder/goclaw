          </div>
          <div className="grid gap-1.5">
            <InfoLabel tip={t("gateway.allowedOriginsTip")}>{t("gateway.allowedOrigins")}</InfoLabel>
            <TagInput
              value={draft.allowed_origins ?? []}
              onChange={(v) => update({ allowed_origins: v })}
