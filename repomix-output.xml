		 progress_percent = NULL,
		 updated_at = $2
		 WHERE id = $3 AND status = $4 AND team_id = $5 AND tenant_id = $6`,
		store.TeamTaskStatusCompleted, now,
		taskID, store.TeamTaskStatusInReview, teamID, tid,
	)
	if err != nil {
