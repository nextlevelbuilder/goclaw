-- Translation rules applied:
--   UUID          → TEXT (36-char string)
--   TIMESTAMPTZ   → TEXT (RFC3339)
--   JSONB         → TEXT (JSON string)
--   BYTEA         → BLOB
--   SERIAL/BIGSERIAL → INTEGER PRIMARY KEY AUTOINCREMENT
