	id := uuid.New()
	status := p.Status
	if status == "" {
		status = "active"
	}
	version := p.Version
	if version == 0 {
		version = s.nextBySlug[p.Slug] + 1
	}
	if version > s.nextBySlug[p.Slug] {
		s.nextBySlug[p.Slug] = version
	}
	s.skills[id] = store.SkillInfo{
		ID:          id.String(),
		Name:        p.Name,
		Slug:        p.Slug,
		Path:        filepath.Join(p.FilePath, "SKILL.md"),
		BaseDir:     p.FilePath,
		Version:     version,
		Status:      status,
		Enabled:     true,
		MissingDeps: append([]string(nil), p.MissingDeps...),
	}
	return id, nil
}

