			&d.Status, &errStr, &metadata, &tags, &teamID, &d.CreatedAt); err != nil {
			continue
		}

		d.ParentTraceID = parentTraceID
		d.AgentID = agentID
		d.TeamID = teamID
		d.UserID = derefStr(userID)
		d.SessionKey = derefStr(sessionKey)
		d.RunID = derefStr(runID)
		d.EndTime = endTime
