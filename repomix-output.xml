			},
			want: false,
		},
		{
			name: "nil schema",
			schema: nil,
			want:   false,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			got := IsMultiActionSchema(tt.schema)
