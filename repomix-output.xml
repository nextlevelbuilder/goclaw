/** Agent event payload from WS event "agent" */
export interface AgentEventPayload {
  type: string; // "run.started" | "run.completed" | "run.failed" | "run.cancelled" | "chunk" | "tool.call" | "tool.result" | "activity" | "block.reply" | "run.retrying"
  agentId: string;
