	if decision.EffectiveEffort != "high" {
		t.Fatalf("EffectiveEffort = %q, want high", decision.EffectiveEffort)
	}
	if decision.RequestEffort() != "high" {
		t.Fatalf("RequestEffort() = %q, want high", decision.RequestEffort())
	}
}

