// Wire format types matching Go pkg/protocol/ exactly.

export const PROTOCOL_VERSION = 3;

// --- Frame types ---

export interface RequestFrame {
  type: "req";
  id: string;
  method: string;
  params?: Record<string, unknown>;
}

export interface ResponseFrame {
  type: "res";
  id: string;
  ok: boolean;
