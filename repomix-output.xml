			tokens, result := extractSlackTokens(tt.input)
			if len(tokens) != tt.expectedCount {
				t.Errorf("extractSlackTokens(%q) returned %d tokens, want %d", tt.input, len(tokens), tt.expectedCount)
			}
			if tt.expectedCount > 0 && result == tt.input {
