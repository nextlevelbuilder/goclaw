func TestHTTPError_ErrorString(t *testing.T) {
	err := &HTTPError{Status: 429, Body: "rate limited"}
	got := err.Error()
	want := "HTTP 429: rate limited"
	if got != want {
		t.Fatalf("got %q, want %q", got, want)
	}
}
