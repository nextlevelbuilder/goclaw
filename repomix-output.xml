		 WHERE id = $3 AND status = $4 AND team_id = $5 AND tenant_id = $6`,
		store.TeamTaskStatusInReview, time.Now(),
		taskID, store.TeamTaskStatusInProgress, teamID, tid,
	)
	if err != nil {
		return err
