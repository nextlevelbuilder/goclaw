# ──────────────────────────────────────────────────────────
# GoClaw - Environment Variables Reference
# Copy to .env or .env.local and fill in required values.
# For Docker Compose, do NOT use 'export' prefix.
# ──────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────
GOCLAW_CONFIG=                          # Path to config.json file. Default: ./config.json
GOCLAW_HOST=                            # Network interface to bind. Default: 0.0.0.0
GOCLAW_PORT=                            # TCP port for HTTP/WebSocket server. Default: 18790
GOCLAW_DATA_DIR=                        # Root directory for all persistent data. Default: ~/.goclaw/data
GOCLAW_WORKSPACE=                       # Root directory for agent file operations. Default: ~/.goclaw/workspace
GOCLAW_OWNER_IDS=                       # Comma-separated user IDs with admin access. Default: (empty)

# ── Security & Auth ──────────────────────────────────────
GOCLAW_GATEWAY_TOKEN=                   # Bearer token required for all client connections. Default: (empty = no auth)
GOCLAW_GATEWAY_URL=                     # Full gateway URL for CLI auth, e.g. http://localhost:18790. Default: (empty)
GOCLAW_TOKEN=                           # Alias for GATEWAY_TOKEN, used by CLI commands. Default: (empty)
GOCLAW_ENCRYPTION_KEY=                  # AES-256 key for encrypting secrets in database. Default: (auto-generated by onboard)

# ── Database ─────────────────────────────────────────────
GOCLAW_POSTGRES_DSN=                    # PostgreSQL connection string, required for managed mode. Default: (empty)
GOCLAW_REDIS_DSN=                       # Redis connection string for distributed caching. Default: (empty, in-memory cache)
GOCLAW_MIGRATIONS_DIR=                  # Path to SQL migration files. Default: ./migrations
GOCLAW_AUTO_UPGRADE=                    # Auto-run schema migrations on startup. Default: false

# ── Default AI ───────────────────────────────────────────
GOCLAW_PROVIDER=                        # Fallback LLM provider when config has no value. Default: anthropic
GOCLAW_MODEL=                           # Fallback model when config has no value. Default: claude-sonnet-4-5-20250929

# ── LLM Provider API Keys ───────────────────────────────
GOCLAW_ANTHROPIC_API_KEY=               # Anthropic Claude API key. Default: (empty)
GOCLAW_ANTHROPIC_BASE_URL=              # Custom Anthropic API base URL for proxies. Default: (official API)
GOCLAW_OPENAI_API_KEY=                  # OpenAI API key (GPT-4, GPT-5, o-series). Default: (empty)
GOCLAW_OPENAI_BASE_URL=                 # Custom OpenAI API base URL for Azure/proxies. Default: (official API)
GOCLAW_OPENROUTER_API_KEY=              # OpenRouter unified API key (multi-model). Default: (empty)
GOCLAW_GROQ_API_KEY=                    # Groq API key (fast inference). Default: (empty)
GOCLAW_DEEPSEEK_API_KEY=                # DeepSeek API key. Default: (empty)
GOCLAW_GEMINI_API_KEY=                  # Google Gemini API key. Default: (empty)
GOCLAW_MISTRAL_API_KEY=                 # Mistral AI API key. Default: (empty)
GOCLAW_XAI_API_KEY=                     # xAI (Grok) API key. Default: (empty)
GOCLAW_MINIMAX_API_KEY=                 # MiniMax API key. Default: (empty)
GOCLAW_COHERE_API_KEY=                  # Cohere API key. Default: (empty)
GOCLAW_PERPLEXITY_API_KEY=              # Perplexity API key (search-augmented). Default: (empty)
GOCLAW_DASHSCOPE_API_KEY=               # Alibaba DashScope API key (Qwen models). Default: (empty)
GOCLAW_BAILIAN_API_KEY=                 # Alibaba Bailian API key (Qwen coding). Default: (empty)
GOCLAW_ZAI_API_KEY=                     # Zai API key. Default: (empty)
GOCLAW_ZAI_CODING_API_KEY=              # Zai Coding API key. Default: (empty)
GOCLAW_OLLAMA_HOST=                     # Local Ollama server URL. Default: (empty, e.g. http://localhost:11434)
GOCLAW_OLLAMA_CLOUD_API_KEY=            # Ollama Cloud API key. Default: (empty)
GOCLAW_OLLAMA_CLOUD_API_BASE=           # Ollama Cloud API base URL. Default: (empty)

# ── Claude CLI Provider ──────────────────────────────────
GOCLAW_CLAUDE_CLI_PATH=                 # Path to claude binary. Default: claude
GOCLAW_CLAUDE_CLI_MODEL=                # CLI model alias: sonnet, opus, haiku. Default: sonnet
GOCLAW_CLAUDE_CLI_WORK_DIR=             # Base directory for CLI agent workspaces. Default: {DATA_DIR}/cli-workspaces

# ── Channels ─────────────────────────────────────────────
GOCLAW_TELEGRAM_TOKEN=                  # Telegram Bot API token. Auto-enables channel when set. Default: (empty)
GOCLAW_DISCORD_TOKEN=                   # Discord bot token. Auto-enables channel when set. Default: (empty)
GOCLAW_ZALO_TOKEN=                      # Zalo OA access token. Auto-enables channel when set. Default: (empty)
GOCLAW_LARK_APP_ID=                     # Lark/Feishu app ID. Auto-enables with APP_SECRET. Default: (empty)
GOCLAW_LARK_APP_SECRET=                 # Lark/Feishu app secret. Default: (empty)
GOCLAW_LARK_ENCRYPT_KEY=                # Lark/Feishu event encryption key. Default: (empty)
GOCLAW_LARK_VERIFICATION_TOKEN=         # Lark/Feishu webhook verification token. Default: (empty)
GOCLAW_WHATSAPP_BRIDGE_URL=             # WhatsApp bridge server URL. Auto-enables channel when set. Default: (empty)
GOCLAW_SLACK_BOT_TOKEN=                 # Slack bot OAuth token (xoxb-...). Auto-enables with APP_TOKEN. Default: (empty)
GOCLAW_SLACK_APP_TOKEN=                 # Slack app-level token for Socket Mode (xapp-...). Default: (empty)
GOCLAW_SLACK_USER_TOKEN=                # Slack user OAuth token (xoxp-...), optional. Default: (empty)

# ── Skills ───────────────────────────────────────────────
GOCLAW_SKILLS_DIR=                      # Global skills storage directory (user-created). Default: {DATA_DIR}/skills
GOCLAW_BUILTIN_SKILLS_DIR=              # Built-in skills directory (shipped with binary). Default: (empty)
GOCLAW_BUNDLED_SKILLS_DIR=              # Bundled skills directory (Docker image). Default: (empty)

# ── Sandbox (Docker) ────────────────────────────────────
GOCLAW_SANDBOX_MODE=                    # Sandbox execution mode: docker | off. Default: off
GOCLAW_SANDBOX_IMAGE=                   # Docker image for sandbox containers. Default: (empty)
GOCLAW_SANDBOX_WORKSPACE_ACCESS=        # Workspace mount mode: read-only | read-write | none. Default: (empty)
GOCLAW_SANDBOX_SCOPE=                   # Sandbox scope: per-user | per-session | shared. Default: (empty)
GOCLAW_SANDBOX_MEMORY_MB=               # Container memory limit in MB. Default: (empty, e.g. 512)
GOCLAW_SANDBOX_CPUS=                    # Container CPU quota, e.g. 1.0 = one full core. Default: (empty)
GOCLAW_SANDBOX_TIMEOUT_SEC=             # Max execution time in seconds before kill. Default: (empty)
GOCLAW_SANDBOX_NETWORK=                 # Enable container network access. Default: false

# ── Telemetry (OpenTelemetry) ────────────────────────────
GOCLAW_TELEMETRY_ENABLED=               # Enable OTEL trace export (requires -tags otel build). Default: false
GOCLAW_TELEMETRY_ENDPOINT=              # OTLP exporter endpoint (host:port). gRPC=4317, HTTP=4318. Default: (empty)
GOCLAW_TELEMETRY_PROTOCOL=              # Transport protocol: grpc | http. Default: grpc
GOCLAW_TELEMETRY_SERVICE_NAME=          # Service name reported in traces. Default: goclaw-gateway
GOCLAW_TELEMETRY_INSECURE=              # Disable TLS for OTLP connection, dev only. Default: false

# ── Text-to-Speech ──────────────────────────────────────
GOCLAW_TTS_OPENAI_API_KEY=              # OpenAI TTS API key for voice responses. Default: (empty)
GOCLAW_TTS_ELEVENLABS_API_KEY=          # ElevenLabs TTS API key. Default: (empty)
GOCLAW_TTS_MINIMAX_API_KEY=             # MiniMax TTS API key. Default: (empty)
GOCLAW_TTS_MINIMAX_GROUP_ID=            # MiniMax TTS group ID. Default: (empty)

# ── Browser Automation ──────────────────────────────────
GOCLAW_BROWSER_REMOTE_URL=              # Remote Chrome DevTools URL. Auto-enables browser when set. Default: (empty, e.g. ws://chrome:9222)

# ── Tailscale (tsnet) ───────────────────────────────────
GOCLAW_TSNET_HOSTNAME=                  # Tailscale machine hostname. Enables Tailscale when set. Default: (empty)
GOCLAW_TSNET_AUTH_KEY=                  # Tailscale auth key for headless login. Default: (empty)
GOCLAW_TSNET_DIR=                       # Tailscale state directory. Default: (empty)

# ── Debug / Internal ────────────────────────────────────
GOCLAW_DEBUG=                           # Enable debug logging for CLI providers. Default: 0
GOCLAW_TRACE_VERBOSE=                   # Verbose trace output for debugging. Default: (empty)
